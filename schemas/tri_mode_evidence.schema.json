{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NAVI Tri-Mode evidence envelope",
  "type": "object",
  "required": [
    "case_id",
    "observed_at",
    "sources",
    "objective",
    "interpretive",
    "systems",
    "governance"
  ],
  "properties": {
    "case_id": {
      "type": "string"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "url",
          "retrieved_at"
        ],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "retrieved_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "objective": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claim",
          "source_index",
          "status"
        ],
        "properties": {
          "claim": {
            "type": "string"
          },
          "source_index": {
            "type": "integer",
            "minimum": 0
          },
          "status": {
            "enum": [
              "verified",
              "disputed",
              "unverified"
            ]
          }
        }
      }
    },
    "interpretive": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "interpretation",
          "attribution"
        ],
        "properties": {
          "interpretation": {
            "type": "string"
          },
          "attribution": {
            "type": "string"
          }
        }
      }
    },
    "systems": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "dependency",
          "impact",
          "owner"
        ],
        "properties": {
          "dependency": {
            "type": "string"
          },
          "impact": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          }
        }
      }
    },
    "governance": {
      "type": "object",
      "required": [
        "decision",
        "authorized"
      ],
      "properties": {
        "decision": {
          "enum": [
            "observe",
            "propose",
            "execute"
          ]
        },
        "authorized": {
          "type": "boolean"
        },
        "receipt_ref": {
          "type": "string"
        }
      }
    }
  }
}
