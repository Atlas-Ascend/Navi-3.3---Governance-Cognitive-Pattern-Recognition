{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ghostatlas.example/schemas/navi/pattern-signal.schema.json",
  "title": "NAVI PatternSignal",
  "type": "object",
  "required": ["schema_version", "signal_id", "detector_id", "detector_version", "pattern_class", "summary", "scope", "window_start", "window_end", "supporting_observation_ids", "confidence", "severity", "explanation", "recommended_routes", "requires_verification", "created_at"],
  "properties": {
    "schema_version": {"type": "string"},
    "signal_id": {"type": "string", "minLength": 1},
    "detector_id": {"type": "string", "minLength": 1},
    "detector_version": {"type": "string", "minLength": 1},
    "pattern_class": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "scope": {"type": "object"},
    "window_start": {"type": "string", "format": "date-time"},
    "window_end": {"type": "string", "format": "date-time"},
    "supporting_observation_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "counterevidence_ids": {"type": "array", "items": {"type": "string"}, "default": []},
    "confidence": {
      "type": "object",
      "required": ["score", "basis"],
      "properties": {
        "score": {"type": "number", "minimum": 0, "maximum": 1},
        "basis": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "severity": {"enum": ["informational", "attention", "verification_required", "governance_conflict", "security_review", "critical"]},
    "explanation": {"type": "string", "minLength": 1},
    "governance_refs": {"type": "array", "items": {"type": "string"}, "default": []},
    "recommended_routes": {"type": "array", "items": {"type": "string"}},
    "requires_verification": {"type": "boolean"},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": true
}
